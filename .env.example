# Секреты (не коммитить!)
BOT_TOKEN="ВАШ_ТОКЕН_ОТ_BOTFATHER"
GIGACHAT_API_KEY="ВАШ_КЛЮЧ_GIGACHAT"

# Текстовая модель
GIGACHAT_MODEL="GigaChat-2-Max"
GIGACHAT_SCOPE="GIGACHAT_API_PERS"

# Базы данных.
# SOURCE/APP идут в psycopg -> обычная схема postgresql://
# VECTOR идёт в SQLAlchemy (langchain-postgres) -> postgresql+psycopg://
SOURCE_DATABASE_URL="postgresql://postgres:postgres@localhost:5432/courses_for_bu"
APP_DATABASE_URL="postgresql://postgres:postgres@localhost:5432/app"
VECTOR_DATABASE_URL="postgresql+psycopg://postgres:postgres@localhost:5432/rag"

# Векторный поиск
COLLECTION_NAME="knowledge"
EMBEDDING_MODEL="intfloat/multilingual-e5-small"
EMBEDDING_FALLBACK_MODEL="intfloat/multilingual-e5-large"
EMBEDDING_BATCH_SIZE="16"
EMBEDDING_DEVICE="cpu"
TOP_K="5"
SCORE_THRESHOLD="0.84"

# История чатов бота (asyncpg, db/history.py).
# В Docker compose эти значения переопределяются на хост db.
DB_HOST="localhost"
DB_PORT="5432"
DB_NAME="app"
DB_USER="postgres"
DB_PASSWORD="postgres"
